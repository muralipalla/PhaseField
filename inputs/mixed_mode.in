# Mixed-mode demonstration: full relative displacement is applied to the top
# edge while the bottom edge is clamped.  Values use the kN-mm unit system.

width 1.0
height 1.0
notch_length 0.20
nx 20
ny 20

young_modulus 210.0
poisson_ratio 0.30
fracture_toughness 2.7e-3
length_scale 0.150
material_mode uniform

mechanical_bc_scheme relative_clamped
max_displacement 5.0e-4
max_sliding_displacement 2.5e-4
load_steps 3

output_directory results/mixed_mode
write_xdmf true
write_material_fields false
make_plots true
strict_mesh_resolution true
