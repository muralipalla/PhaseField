# PETSc/MPI mixed-mode demonstration.  The full relative opening and sliding
# displacements are imposed on the top edge; the bottom edge is clamped.
width 1.0
height 1.0
notch_length 0.20
nx 40
ny 40

young_modulus 210.0
poisson_ratio 0.30
fracture_toughness 2.7e-3
length_scale 0.080
material_mode uniform

mechanical_bc_scheme relative_clamped
max_displacement 1.0e-3
max_sliding_displacement 5.0e-4
load_steps 5

output_directory results/linux_mixed_mode
write_xdmf true
write_material_fields false
make_plots true
strict_mesh_resolution true
