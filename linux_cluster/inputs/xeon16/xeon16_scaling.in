# Fixed-work strong-scaling problem. Output and console noise are minimized so
# summary.elapsed_seconds primarily measures assembly and PETSc solution work.
width 1.0
height 1.0
notch_length 0.20
nx 320
ny 320

young_modulus 210.0
young_modulus_end 210.0
poisson_ratio 0.30
poisson_ratio_end 0.30
fracture_toughness 2.7e-3
fracture_toughness_end 2.7e-3
length_scale 0.020
length_scale_end 0.020
material_mode uniform

mechanical_bc_scheme legacy_roller_pin
max_displacement 5.0e-4
max_sliding_displacement 0.0
load_steps 10

max_newton_iterations 30
max_staggered_iterations 80
staggered_tolerance 1.0e-5
staggered_mechanical_tolerance 1.0e-6
phase_kkt_tolerance 1.0e-8
max_load_cutbacks 8
load_cutback_factor 0.5

output_directory results/xeon16_scaling
write_every 10
write_xdmf false
write_material_fields false
make_plots false
strict_mesh_resolution true
verbose false

displacement_snes_type newtonls
displacement_ksp_type gmres
displacement_pc_type gamg
phase_snes_type vinewtonrsls
phase_ksp_type cg
phase_pc_type gamg
ksp_relative_tolerance 1.0e-10
ksp_absolute_tolerance 1.0e-14
ksp_max_iterations 1000
petsc_monitor false
