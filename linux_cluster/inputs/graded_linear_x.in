# PETSc/MPI left-to-right material gradient.
width 1.0
height 1.0
notch_length 0.20
nx 40
ny 40

material_mode linear_x
young_modulus 210.0
young_modulus_end 105.0
poisson_ratio 0.30
poisson_ratio_end 0.30
fracture_toughness 2.7e-3
fracture_toughness_end 1.8e-3
length_scale 0.080
length_scale_end 0.080

mechanical_bc_scheme legacy_roller_pin
max_displacement 1.0e-3
max_sliding_displacement 0.0
load_steps 5

output_directory results/linux_graded_linear_x
write_xdmf true
write_material_fields true
make_plots true
strict_mesh_resolution true
