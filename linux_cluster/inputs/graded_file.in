# PETSc/MPI file-defined material case.  The relative path is anchored at this
# input file, so it remains valid when submitted from the project root.
width 1.0
height 1.0
notch_length 0.20
nx 40
ny 40

material_mode file
material_file materials/inclusion.material
length_scale 0.080

mechanical_bc_scheme relative_clamped
max_displacement 1.0e-3
max_sliding_displacement 3.0e-4
load_steps 5

output_directory results/linux_graded_file
write_xdmf true
write_material_fields true
make_plots true
strict_mesh_resolution true
