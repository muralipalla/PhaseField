#!/usr/bin/env bash
#PBS -N phasefield-petsc
#PBS -l select=1:ncpus=2:mpiprocs=2
#PBS -l walltime=04:00:00
#PBS -l mem=32gb
#PBS -j oe

# The two-rank request is a safe template default. Override the resource at
# submission, for example: qsub -l select=1:ncpus=4:mpiprocs=4 this-file.pbs

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "${PHASEFIELD_PROJECT_ROOT:-${SUBMIT_DIR}}/linux_cluster/run_linux.sh" ]]; then
  PROJECT_ROOT="${PHASEFIELD_PROJECT_ROOT:-${SUBMIT_DIR}}"
elif [[ -f "${SUBMIT_DIR}/run_linux.sh" ]]; then
  SCRIPT_DIR="${SUBMIT_DIR}"
  PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
else
  echo "Submit from the project root or set PHASEFIELD_PROJECT_ROOT." >&2
  exit 2
fi
SCRIPT_DIR="${SCRIPT_DIR:-${PROJECT_ROOT}/linux_cluster}"

if [[ -n "${PBS_NP:-}" ]]; then
  export NPROCS="${PBS_NP}"
elif [[ -r "${PBS_NODEFILE:-}" ]]; then
  export NPROCS="$(wc -l < "${PBS_NODEFILE}" | tr -d '[:space:]')"
else
  echo "PBS_NP/PBS_NODEFILE is unavailable; cannot determine MPI size." >&2
  exit 2
fi
if [[ -r "${PBS_NODEFILE:-}" ]]; then
  export EXPECTED_NODES="$(sort -u "${PBS_NODEFILE}" | wc -l | tr -d '[:space:]')"
fi

export MPI_PREFERENCE="${MPI_PREFERENCE:-${MPI_LAUNCHER:-auto}}"
export INPUT_FILE="${INPUT_FILE:-${SCRIPT_DIR}/inputs/notched_tension_cluster.in}"
export OUTPUT_DIR="${OUTPUT_DIR:-${PROJECT_ROOT}/results/pbs_${PBS_JOBID}_${NPROCS}r}"

# Add site-specific module commands only if required by your cluster. The
# launcher compatibility-tests a discovered site MPI before using it.
bash "${SCRIPT_DIR}/run_linux.sh"
